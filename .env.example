# Variáveis de Build / Execução do Cliente
CLIENTE=cliente01

# Configurações do Supabase (para Backup Excel e Fallbacks)
SUPABASE_URL=https://sua-url-do-supabase.supabase.co
SUPABASE_ANON_KEY=sua-api-key-anon-do-supabase

# Configurações de API de e-mail (Resend) para Backup Excel
RESEND_API_KEY=re_your_api_key
EMAIL_DESTINATARIO=seu-email@dominio.com

# ⚠️ IMPORTANTE: Renomeie este arquivo para '.env' para execução local.
# O arquivo '.env' nunca deve ser enviado para o repositório Git!
